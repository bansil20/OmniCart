# OmniCart Backend Environment Configuration Example
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/omnicart?retryWrites=true&w=majority
JWT_SECRET=your_production_secure_jwt_secret_key_here

# Gmail SMTP Configuration for Real Email OTPs
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
